{
	"luci-app-haproxy-advanced": {
		"description": "Grant access to HAProxy Advanced LuCI app",
		"read": {
			"ubus": {
				"luci-rpc": [ "getBoardJSON", "getHostHints", "getNetworkDevices", "getWirelessDevices" ],
				"network": [ "get_proto_handlers" ],
				"network.device": [ "status" ],
				"network.interface": [ "dump" ]
			},
			"uci": [ "haproxy-advanced", "luci", "network", "wireless" ],
			"file": {
				"/etc/init.d/haproxy-advanced preview": [ "exec" ],
				"/etc/init.d/haproxy-advanced validate": [ "exec" ],
				"/etc/init.d/haproxy-advanced status": [ "exec" ],
				"/etc/init.d/haproxy-advanced logs": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "haproxy-advanced" ],
			"file": {
				"/etc/init.d/haproxy-advanced reload": [ "exec" ],
				"/etc/init.d/haproxy-advanced restart": [ "exec" ],
				"/etc/init.d/haproxy-advanced start": [ "exec" ],
				"/etc/init.d/haproxy-advanced stop": [ "exec" ]
			}
		}
	}
}
