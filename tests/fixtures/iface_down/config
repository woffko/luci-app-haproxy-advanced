config global 'global'
	option enabled '1'

config listener 'test'
	list address 'hatest'
	option port '18443'
	option firewall '1'

config listener 'pub'
	list address 'wan'
	option port '443'

config service 'a'
	option listener 'test'
	list hostname 'a.example.com'
	option backend 'b'
	option certificate '/c/a.pem'

config service 'b'
	option listener 'pub'
	list hostname 'b.example.com'
	option backend 'b'
	option certificate '/c/a.pem'

config backend 'b'

config server
	option backend 'b'
	option name 's'
	option address '192.168.1.2'
	option port '80'
