config global 'global'
	option enabled '1'
	option maxconn '50000'
	option log_level 'notice'
	option log_requests 'all'
	option hardening '0'
	option timeout_connect '3s'
	option timeout_client '2m'
	option timeout_server '90s'
	option timeout_http_request '5s'
	option timeout_http_keep_alive '2s'
	option advanced 'nbthread 2
tune.bufsize 32768'

config listener 'pub'
	option port '443'
	option http2 '0'
	option default_certificate '/c/default.pem'
	option timeout_client '30s'
	option advanced 'option http-buffer-request'

config service 'a'
	option listener 'pub'
	list hostname 'a.example.com'
	option backend 'b'
	option certificate '/c/a.pem'
	option timeout_client '10m'
	list request_header 'X-Proxy: haproxy-advanced'
	list request_header 'X-Empty:'
	option advanced 'http-response del-header Server
http-after-response set-header X-Frame-Options SAMEORIGIN'

config service 'b'
	option listener 'pub'
	list hostname 'b.example.com'
	option backend 'b'
	option certificate '/c/b.pem'
	option hardening '1'
	option forward_headers '0'
	option hsts '1'
	option hsts_max_age '600'
	option hsts_subdomains '1'

config backend 'b'

config server
	option backend 'b'
	option name 's'
	option address '192.168.1.2'
	option port '80'
