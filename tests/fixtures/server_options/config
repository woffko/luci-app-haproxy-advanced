config global 'global'
	option enabled '1'

config listener 'pub'
	option port '443'

config service 'a'
	option listener 'pub'
	list hostname 'a.example.com'
	list hostname 'A.Example.com'
	option backend 'pool'
	option certificate '/c/a.pem'
	option hardening '0'
	option forward_headers '0'

config backend 'pool'
	option balance 'leastconn'
	option health_check 'http'
	option check_method 'HEAD'
	option check_path '/health?full=1'
	option check_host 'Health.Example.com'
	list check_status '200'
	list check_status '3xx'
	option check_interval '5s'
	option timeout_connect '2s'
	option timeout_server '30s'
	option timeout_tunnel '1h'
	option advanced 'option redispatch
retries 2'

config server
	option backend 'pool'
	option name 'tls-ca'
	option address '192.168.1.10'
	option port '443'
	option tls '1'
	option verify 'required'
	option ca_file '@system-ca'
	option sni 'host'
	option verifyhost 'App.Internal'
	option weight '10'

config server
	option backend 'pool'
	option name 'tls.named'
	option address 'Backend.LAN'
	option port '443'
	option tls '1'
	option sni 'Fixed.Example.com'
	option ca_file '/etc/ssl/certs/lan-ca.crt'
	option maxconn '50'

config server
	option backend 'pool'
	option name 'v6'
	option address 'fd00::10'
	option port '80'
	option backup '1'
	option send_proxy '1'
	option weight '0'
